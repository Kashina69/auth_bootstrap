# Local-only dev config (untracked). Never commit real secrets.
NODE_ENV=development
AUTH_STRATEGY=jwt-stateless
RBAC_STRATEGY=db-live
DB_PROVIDER=prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth
JWT_ALGORITHM=HS256
JWT_SECRET="0+e2z9pucjAi9MDkhosIKa26fxJ5mwG76gGL9DWrSrgQmqHMZSHsAwWBFIbFYzQ1"
# Redis: required for db-live (RBAC cache) — local container nest-auth-redis
REDIS_URL=redis://localhost:6379
# Backend listens on :8080 (PORT is schema-validated, so the .env value is honored)
PORT=8080
# Client origin(s) allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000
