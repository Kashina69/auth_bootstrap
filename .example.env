# ============================================================================
# auth service — environment template
# Copy to `.env` and adjust. The app validates this file at boot (zod) and
# REFUSES TO START on anything invalid — a bad value is a crash, never a
# silent insecure fallback.
#
# Minimal local setup (Postgres + migrations + baseline RBAC + dev server):
#   docker run -d --name nest-auth-postgres \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=auth -p 5432:5432 postgres:16
#   docker exec -i nest-auth-postgres psql -U postgres -d auth -v ON_ERROR_STOP=1 \
#     -f - < src/database/migrations/20260911000000_init/migration.sql
#   docker exec -i nest-auth-postgres psql -U postgres -d auth -v ON_ERROR_STOP=1 \
#     -f - < src/database/migrations/20260914000000_permission_is_system/migration.sql
#   pnpm seed:rbac        # idempotent: 3 roles + 8 permissions baseline (register needs it)
#   pnpm start:dev
# ============================================================================

# --- Server ---------------------------------------------------------------
# Deployment mode. Affects GraphQL playground/introspection (dev-only).
# Possible values: development | test | production
NODE_ENV=development

# HTTP port. Default 3000 when unset. 1-65535.
PORT=8080

# --- Auth strategy: HOW sessions are issued -------------------------------
# Possible values: jwt-stateless | session-redis   (default: jwt-stateless)
#
# jwt-stateless — USE THIS unless you have a reason not to. Short-lived signed
#   access token (15m, verified by crypto, no DB hit) + opaque rotating refresh
#   token (30d, single-use, reuse detection). Client sends
#   `Authorization: Bearer <accessToken>`; refresh via POST /auth/refresh.
#   Needs NO Redis. Logout revokes all refresh tokens for the user.
#
# session-redis — server-side sessions in Redis, delivered as an httpOnly
#   `sid` cookie (SameSite=strict). Needs REDIS_URL + CORS_ORIGINS with
#   credentials. WARNING: experimental in this repo — logout currently no-ops
#   and the cookie is not attached on all paths (see README open items S1/S2).
AUTH_STRATEGY=jwt-stateless

# --- RBAC strategy: WHERE roles/permissions are read from -----------------
# Possible values: embedded-claims | db-live   (default: embedded-claims)
#
# embedded-claims — roles/permissions are baked into the access token at
#   login/refresh. Fast (zero DB hit per request), but grant changes only take
#   effect after the next refresh. Good default for most apps.
#
# db-live — every request re-resolves grants from the DB (5s cache). Grant
#   changes apply near-instantly. Needs REDIS_URL for the cache. Use when
#   permission changes must propagate immediately (e.g. ban/demote flows).
RBAC_STRATEGY=embedded-claims

# --- Database ---------------------------------------------------------------
# Possible values: prisma | drizzle | sequelize | mongoose   (default: prisma)
# All four implement the same repository contracts; switching needs no code
# change — just the provider value + a matching DATABASE_URL.
DB_PROVIDER=prisma

# prisma / drizzle / sequelize expect PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth
# mongoose reuses this as the Mongo URI instead, e.g.:
# DATABASE_URL=mongodb://localhost:27017/auth

# --- JWT signing --------------------------------------------------------------
# Possible values: RS256 | HS256   (default: RS256)
#
# RS256 — asymmetric. Services holding only the PUBLIC key can verify.
#   Use for production / multi-service setups. Requires BOTH keys below (PEM).
# HS256 — symmetric, one shared secret (min 32 chars). Simpler for local dev
#   and single-service deploys; anyone with the secret can mint tokens.
JWT_ALGORITHM=HS256

# Dev-only secret. REPLACE with a strong random value in production, e.g.:
#   openssl rand -base64 48
# Only used when JWT_ALGORITHM=HS256.
JWT_SECRET="REPLACE-ME-with-a-32-plus-char-secret-for-dev-only-0000"

# Only used when JWT_ALGORITHM=RS256 (both required then). Paste full PEM:
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# NOTE: token lifetimes are NOT env-tunable — they are code constants in
# src/config/constants.ts: access 15m, refresh 30d, issuer "auth-service",
# audience "auth-clients". Change them there if you must.

# --- Redis ----------------------------------------------------------------------
# Required when AUTH_STRATEGY=session-redis OR RBAC_STRATEGY=db-live.
# (Also enables per-account login lockout; without it, logins are only
# rate-limited per IP and you'll see a WARN at boot — safe for local dev.)
# REDIS_URL=redis://localhost:6379

# --- CORS -------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. OPTIONAL —
# when unset, CORS stays completely off (deny-all), which breaks any
# browser client on a different origin/port. Always include your frontend
# origin(s) here, e.g. a Next.js dev server.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
